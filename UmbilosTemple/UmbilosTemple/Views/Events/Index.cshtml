@{
    ViewData["Title"] = "Events";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content" style="background: linear-gradient(to right, #0099a8, #00d64e); padding: 30px; min-height: 90vh;">
    <div class="header" style="font-size: 32px; font-weight: bold; text-align: center; background: linear-gradient(to right, yellow, orange); width: 180px; margin: 0 auto 30px; padding: 10px; border-radius: 10px;">
        EVENTS
    </div>
    <div class="events" style="display: flex; justify-content: space-around; flex-wrap: wrap;">
        <div class="event-left" style="display: flex; flex-direction: column; gap: 20px;">
            <div class="event-item" style="background-color: #ffcd55; padding: 15px 25px; border-radius: 10px; font-weight: bold; text-align: center;">
                Firewalking Ceremony
            </div>
            <div class="event-item" style="background-color: #ffcd55; padding: 15px 25px; border-radius: 10px; font-weight: bold; text-align: center;">
                Dehoisting Flag & Kangie Prayer
            </div>
        </div>
        <div class="event-right" style="display: flex; flex-direction: column; gap: 20px;">
            <div class="event-time" style="background-color: #ffcd55; padding: 15px 25px; border-radius: 10px; font-weight: bold; text-align: center;">
                6 April 2025 &nbsp; - &nbsp; 3pm
            </div>
            <div class="event-time" style="background-color: #ffcd55; padding: 15px 25px; border-radius: 10px; font-weight: bold; text-align: center;">
                8 April 2025 &nbsp; - &nbsp; 6pm
            </div>
        </div>
    </div>
</div>
