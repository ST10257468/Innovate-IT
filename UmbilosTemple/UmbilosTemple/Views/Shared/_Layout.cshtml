<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UmbilosTemple</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UmbilosTemple.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="custom-navbar">
            <div class="navbar-logo">
                <img src="~/images/logo.png" alt="Temple Logo" />
            </div>

            <ul class="navbar-links">
                <li>
                    <a asp-controller="Home" asp-action="Index">
                        <div class="icon-box">
                            <img src="~/images/icons/Book.png" alt="Home" />
                            <span>Home</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a asp-controller="About" asp-action="Index">
                        <div class="icon-box">
                            <img src="~/images/icons/Scroll.png" alt="About" />
                            <span>About</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a asp-controller="Events" asp-action="Index">
                        <div class="icon-box">
                            <img src="~/images/icons/Events.png" alt="Events" />
                            <span>Events</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a asp-controller="Donations" asp-action="Index">
                        <div class="icon-box">
                            <img src="~/images/icons/Donation.png" alt="Donate" />
                            <span>Donate</span>
                        </div>
                    </a>
                </li>
            </ul>
        </nav>
    </header>
                  
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - UmbilosTemple - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
