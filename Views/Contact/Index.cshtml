@model UmbiloTemple.Models.ContactMessage
@{
    ViewData["Title"] = "Contact";
}

<!-- HEADER -->
<section class="text-center py-5" style="background-color:#06281e;">
    <div class="container">
        <h1 class="text-yellow fw-bold mb-3">Contact Us</h1>
        <p class="lead">We’d love to hear from you — whether it’s a question, blessing, or prayer request.</p>
    </div>
</section>

<!-- CONTACT DETAILS + FORM -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-start g-5">

            <!-- TEMPLE INFO -->
            <div class="col-md-5" data-aos="fade-right">
                <div class="card bg-deepgreen border-0 shadow-sm p-4">
                    <h4 class="text-yellow fw-bold mb-3">Temple Information</h4>

                    <p>
                        <i class="fas fa-map-marker-alt text-yellow me-2"></i>
                        <strong>890 Vusi Mzimela Road</strong><br />
                          Cato Manor, Durban
                    </p>

                    <p>
                        <i class="fas fa-phone text-yellow me-2"></i>
                        031 261 6509
                    </p>

                    <p>
                        <i class="fas fa-envelope text-yellow me-2"></i>
                        <a href="mailto:umbilotemple@gmail.com" class="text-yellow text-decoration-none">
                            umbilotemple@gmail.com
                        </a>
                    </p>

                    <hr class="border-light" />
                    <p class="small text-muted fst-italic">
                        The Umbilo Shree Ambalavaanar Alayam — serving the community of Durban with faith, culture, and compassion.
                    </p>
                </div>
            </div>

            <!-- CONTACT FORM -->
            <div class="col-md-7" data-aos="fade-left">
                <div class="card bg-darker border-0 shadow-sm p-4">
                    <h4 class="text-yellow fw-bold mb-3">Send Us a Message</h4>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success text-center">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger text-center">@TempData["Error"]</div>
                    }

                    <form asp-action="Index" method="post">
                        <div class="mb-3 text-start">
                            <label class="form-label">Your Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter your name" required />
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label">Your Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" required />
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label">Message</label>
                            <textarea asp-for="Message" rows="4" class="form-control" placeholder="Type your message here" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-temple w-100 mt-2">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAP SECTION -->
<section class="py-5 bg-darker text-center" data-aos="fade-up">
    <div class="container">
        <div class="ratio ratio-4x3 rounded shadow-lg">
            <iframe
                src="https://www.google.com/maps?q=890%20Vusi%20Mzimela%20Road%20Cato%20Manor%20Durban&output=embed"
                width="100%" height="100%" style="border:0;" allowfullscreen loading="lazy"></iframe>
        </div>
    </div>
</section>
